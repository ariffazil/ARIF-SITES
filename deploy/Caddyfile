# arifOS Sovereign Caddyfile
# DITEMPA BUKAN DIBERI
# Trinity: Ψ arif-fazil.com | Ω arifos.arif-fazil.com | Δ aaa.arif-fazil.com
# Organ MCP (API-only): geox | wealth | well | forge
# Infra (internal): ollama | openclaw | claw | deploy | prometheus | grafana | temporal | nats | monitor | vault999
# Legacy redirects: mcp | arifosmcp | wiki
# Last reconcile: 2026-06-20 — Trinity consolidation (wiki→arifos/wiki, mcp simplified, header cleaned)
{
	admin unix//var/run/caddy-admin.sock
	email arif@arif-fazil.com
	http_port 80
	https_port 443
}
(tls_origin) {
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
(shared_assets) {
	handle /_shared/* {
		uri strip_prefix /_shared
		root * /var/www/html/_shared
		file_server
	}
}
(cors_public) {
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Mcp-Session-Id, Authorization, X-Requested-With"
		header Access-Control-Max-Age 86400
		respond "" 204
	}
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Methods "GET, POST, OPTIONS"
	header Access-Control-Allow-Headers "Content-Type, Mcp-Session-Id, Authorization, X-Requested-With"
}
# ═══════════════════════════════════════════════════════════════════════
# MAIN SITE 1 — Ψ HUMAN SURFACE
# ═══════════════════════════════════════════════════════════════════════
www.arif-fazil.com {
	import tls_origin
	redir https://arif-fazil.com{uri} permanent
}
arif-fazil.com {
	import tls_origin
	import shared_assets
	encode zstd gzip
	root * /var/www/html/arif
	@well-known path /.well-known/*
	handle @well-known {
		uri strip_prefix /.well-known
		root * /var/www/html/arif/.well-known
		try_files {path} {path}/index.html /index.html
		file_server
	}
	@genesis path /000/*
	handle @genesis {
		uri strip_prefix /000
		root * /var/www/html/arif/000
		try_files {path} /index.html
		file_server
	}
	@validation path /999/*
	handle @validation {
		uri strip_prefix /999
		root * /var/www/html/arif/999
		try_files {path} /index.html
		file_server
	}
	# Built assets have content-hashed names — serve directly, never SPA fallback
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# SSG pre-rendered pages — serve static HTML instead of SPA shell
	# Homepage
	handle / {
		try_files {path} /static/home.html {path} /index.html
		file_server
	}
	# SSG routes: serve pre-rendered static HTML directly
	handle /canon/* {
		try_files /static/canon.html /index.html
		file_server
	}
	handle /constellation/* {
		try_files /static/constellation.html /index.html
		file_server
	}
	handle /discoveries/* {
		try_files /static/discoveries.html /index.html
		file_server
	}
	handle /essays/* {
		try_files /static/essays.html /index.html
		file_server
	}
	handle /genesis/* {
		try_files /static/genesis.html /index.html
		file_server
	}
	handle /wealth/* {
		try_files /static/wealth.html /index.html
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
