# MAIN SITE 2 — Ω ARIFOS OBSERVATORY
# ═══════════════════════════════════════════════════════════════════════
arifos.arif-fazil.com {
	import tls_origin
	import shared_assets
	encode zstd gzip
	root * /var/www/html/arifos

	# ── MCP API routes → arifOS kernel (port 8088) ──────────────────────────
	handle /.well-known/* {
		reverse_proxy 127.0.0.1:8088
	}

	@llmsfile path /llms.txt
	header @llmsfile {
		Cache-Control "no-cache, no-store, must-revalidate"
		CDN-Cache-Control "no-cache"
		Cloudflare-CDN-Cache-Control "no-cache"
		Pragma "no-cache"
		Expires "0"
	}
	handle /manifest.txt {
		header Cache-Control "no-cache"
		root * /var/www/html/arifos
		file_server
	}
	handle /llms.txt {
		root * /var/www/html/arifos
		file_server
	}

	handle /mcp* {
		import cors_public
		reverse_proxy 127.0.0.1:8088 {
			header_up Accept "text/event-stream, application/json, application/json-rpc"
		}
	}

	handle /api/status {
		reverse_proxy 127.0.0.1:8088
	}

	handle /api/federation-probe {
		reverse_proxy 127.0.0.1:8088
	}

	handle /api/build-info {
		reverse_proxy 127.0.0.1:8088
	}

	# F13 #4 closure (2026-06-11): serve arifOS doctrine (floors F0-F13,
	# scar.json, theory/000/*) publicly so the constitution is legible
	# to any client. The kernel is the source of truth; Caddy is a
	# passthrough file_server, no governance on the bytes themselves
	# (governance is on the AGENT, not the pages).
	handle /static/* {
		reverse_proxy 127.0.0.1:8088
	}

	handle /inspector/sot {
		reverse_proxy 127.0.0.1:8088
	}

	handle /ready {
		reverse_proxy 127.0.0.1:8088
	}

	handle /tools {
		reverse_proxy 127.0.0.1:8088
	}

	handle /tools/* {
		reverse_proxy 127.0.0.1:8088
	}

	handle /tools.json {
		reverse_proxy 127.0.0.1:8088
	}

	handle /sse* {
		reverse_proxy 127.0.0.1:8088 {
			header_up Accept "text/event-stream, application/json, application/json-rpc"
		}
	}

	# ── Phase 3E: Approval ticket mutation ────────────────────────────────────
	handle /approval* {
		reverse_proxy 127.0.0.1:8088
	}

	# ── Organ health proxy routes (bypass Cloudflare challenge for API calls) ─
	handle /api/organs/arifos/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:8088
	}
	handle /api/organs/geox/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:8081
	}
	handle /api/organs/wealth/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:18082
	}
	handle /api/organs/well/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:18083
	}
	handle /api/organs/apex/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:3002
	}
	handle /api/organs/a-forge/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:7071
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8088
	}

	handle /inspector/* {
		reverse_proxy 127.0.0.1:8088
	}

	handle /health {
		reverse_proxy 127.0.0.1:8088
	}

	# ── SSH key files for Termux provisioning (2026-06-14) ──────────────────
	handle /arifos-pubkey.pub {
		file_server
	}
	handle /arifos-hostkey.pub {
		file_server
	}

	# ── SOT dashboard (React SPA) → static files (SPA fallback) ──────────
	# root * MUST be inside handle for file_server (handle scope is
	# separate from vhost scope; without it, file_server falls back to
	# default root and 404s even when files exist).
	handle {
		root * /var/www/html/arifos
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

ai.arif-fazil.com {
