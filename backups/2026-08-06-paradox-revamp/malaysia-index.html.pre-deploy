<style>
.live-strip{margin:0 0 1.2rem;padding:.9rem 1rem;border:1px solid var(--line,#2a2a3a);border-radius:8px;background:rgba(255,255,255,.02);font-family:var(--mono,monospace)}
.live-strip .ls-head{display:flex;align-items:center;gap:.6rem;font-size:.7rem;letter-spacing:.08em;color:var(--dim,#8a8378);margin-bottom:.6rem}
.live-strip .ls-badge{font-weight:700}
.live-strip .ls-chips{display:flex;flex-wrap:wrap;gap:.5rem}
.live-strip .ls-chip{padding:.35rem .6rem;border:1px solid var(--line,#2a2a3a);border-radius:6px;font-size:.72rem;color:var(--text,#d8d2c4)}
.live-strip .ls-chip b{color:var(--gold,#c9a84c)}
.live-strip .ls-chip .up{color:#22c55e}.live-strip .ls-chip .down{color:#ef4444}
.live-strip .ls-note{margin-top:.55rem;font-size:.62rem;color:var(--faint,#5a554d)}

.attention-list{margin:0 0 1.4rem;padding:1rem 1.1rem;border:1px solid var(--accent-dim,#7f1d1d);border-radius:10px;background:var(--accent-bg,rgba(220,38,38,.08))}
.attention-list .al-head{font-family:var(--mono,monospace);font-size:.72rem;letter-spacing:.1em;color:var(--accent,#dc2626);margin-bottom:.7rem;text-transform:uppercase;font-weight:700}
.attention-list ol{margin:0;padding:0;list-style:none;counter-reset:al}
.attention-list li{counter-increment:al;display:flex;align-items:flex-start;gap:.8rem;padding:.55rem 0;border-bottom:1px dashed var(--line,#2a2a3a);font-family:var(--mono,monospace);font-size:.78rem;color:var(--text,#d8d2c4);line-height:1.5}
.attention-list li:last-child{border-bottom:none}
.attention-list li::before{content:counter(al);flex-shrink:0;width:1.4rem;height:1.4rem;border-radius:50%;background:var(--accent,#dc2626);color:#fff;font-weight:700;font-size:.7rem;display:flex;align-items:center;justify-content:center;line-height:1}
.attention-list li b{color:var(--accent,#dc2626);font-weight:700}
.attention-list li .al-meta{font-size:.62rem;color:var(--dim,#8a8378);margin-top:.2rem}

@media (max-width:720px){
  .attention-list li{flex-direction:column;gap:.3rem}
  .attention-list li::before{width:1.2rem;height:1.2rem;font-size:.62rem}
}
</style>
