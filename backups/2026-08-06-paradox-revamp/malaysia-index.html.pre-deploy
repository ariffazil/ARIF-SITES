<script>
/* ============================================================
   LIVE PROXY FEED — bounded wait, no eternal connecting.
   8s AbortController timeout per attempt; 10s overall deadline
   forces fail-state. Sealed tripwire readings remain authoritative.
   ============================================================ */
(function(){
  const API = window.location.origin + '/wealth/gold/api/proxies';
  const TIMEOUT_MS = 8000;
  const OVERALL_DEADLINE_MS = 10000;
  const fmt = (n,d) => n==null ? '—' : Number(n).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
  const lastVerified = { ts: null, text: null };
  function chip(label, val, prev, digits, unit, invert){
    if (val == null) return '<span class="ls-chip">'+label+' <b>—</b></span>';
    const d = prev!=null ? val-prev : 0;
    const dir = d>0 ? (invert?'down':'up') : d<0 ? (invert?'up':'down') : '';
    const arrow = d>0?'▲':d<0?'▼':'·';
    return '<span class="ls-chip">'+label+' <b>'+fmt(val,digits)+'</b> <span class="'+dir+'">'+arrow+'</span>'+(unit?' <span style="opacity:.6">'+unit+'</span>':'')+'</span>';
  }
  function showFailure(badge, chips, time){
    badge.textContent = '∅ UNAVAILABLE';
    badge.style.color = '#ef4444';
    const last = lastVerified.text ? ' · last verified ' + lastVerified.text : '';
    chips.innerHTML = '<span class="ls-chip">Proxies unavailable · sealed inputs remain authoritative'+last+'</span>';
    time.textContent = '—';
  }
  async function load(){
    const badge = document.getElementById('lsBadge');
    const chips = document.getElementById('lsChips');
    const time = document.getElementById('lsTime');
    if (!badge) return;
    const ctrl = new AbortController();
    const t1 = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
    const t2 = setTimeout(() => ctrl.abort(), OVERALL_DEADLINE_MS);
    try {
      const r = await fetch(API, { signal: ctrl.signal, cache: 'no-store' });
      clearTimeout(t1); clearTimeout(t2);
      if (!r.ok) throw new Error('HTTP '+r.status);
      const p = await r.json();
      const ts = new Date(p.timestamp);
      const feedStale = (Date.now() - ts.getTime()) > 15*60*1000;
      badge.textContent = feedStale ? '⚠ STALE' : '● LIVE';
      badge.style.color = feedStale ? '#f59e0b' : '#22c55e';
      const verifiedText = ts.toLocaleString('en-MY',{timeZone:'Asia/Kuala_Lumpur',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) + ' MYT';
      time.textContent = verifiedText;
      lastVerified.ts = ts.getTime();
      lastVerified.text = verifiedText;
      chips.innerHTML = chip('USD/MYR', p.usdmyr, p.usdmyr_prev, 4, 'RM', true)
        + chip('KLCI', p.klci, p.klci_prev, 2, 'pts')
        + chip('Brent', p.brent, p.brent_prev, 2, '$/bbl')
        + chip('DXY', p.dxy, p.dxy_prev, 2, '')
        + chip('EWM · foreign confidence', p.ewm, p.ewm_prev, 2, '$')
    } catch(e) {
      clearTimeout(t1); clearTimeout(t2);
      showFailure(badge, chips, time);
    }
  }
  load(); setInterval(load, 300000);
})();
</script>

<script>
/* ============================================================
   CHARTS — distance-to-trip map + proxy-implied PULSE fan
   The sliders only re-weight sensitivity.
   Sealed TRIPWIRES anchors are never mutated.
   ============================================================ */
(function(){
  /* ── A. distance-to-trip map ── */
  const tc=document.getElementById("twchart"),tx=tc.getContext("2d");
  (function drawTW(){
    const W=tc.width,H=tc.height,left=240,right=60,top=18,rows=TRIPWIRES.length;
    const bh=(H-top-10)/rows;
    tx.clearRect(0,0,W,H);
    // verdict bands
    const bands=[[0,40,"rgba(240,80,110,.07)"],[40,60,"rgba(227,179,65,.06)"],[60,80,"rgba(74,168,255,.05)"],[80,100,"rgba(49,196,141,.06)"]];
    const X=v=>left+(W-left-right)*v/100;
    bands.forEach(([a,b,c])=>{tx.fillStyle=c;tx.fillRect(X(a),top,X(b)-X(a),H-top-10);});
    [40,60,80].forEach(v=>{tx.strokeStyle="rgba(120,120,140,.35)";tx.setLineDash([4,4]);tx.beginPath();tx.moveTo(X(v),top);tx.lineTo(X(v),H-10);tx.stroke();tx.setLineDash([]);});
    tx.font="10px monospace";tx.fillStyle="#5a6675";
    [0,40,60,80,100].forEach(v=>tx.fillText(v,X(v)-6,H-0));
    TRIPWIRES.forEach((t,i)=>{
      const sc=score(t),v=verdict(sc),yy=top+bh*i+bh*0.5;
      tx.fillStyle="#9aa7ba";tx.font="11px monospace";
      tx.fillText("#"+t.id+" "+t.name,8,yy+4);
      tx.fillStyle=v.c;
      tx.fillRect(X(0),yy-bh*0.28,Math.max(2,X(sc)-X(0)),bh*0.56);
      tx.font="bold 11px monospace";
      tx.fillText(sc.toFixed(0),X(sc)+6,yy+4);
      tx.fillStyle="#5a6675";tx.font="9px monospace";
      tx.fillText(t.now+t.unit+" → trip "+t.trip+t.unit,8,yy+13);
    });
  })();

