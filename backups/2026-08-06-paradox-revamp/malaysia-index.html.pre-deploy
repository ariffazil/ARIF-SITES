<script>
/* ============================================================
   MALAYSIA VITALS v1.0 — DATA AS CONSTITUTION
   Internal layer keys: BODY, ENGINE, SOUL (preserved).
   Visible labels: Fiscal capacity, Economic engine, Institutions & demographics.
   ============================================================ */
const SEAL_BASE="2026-07-24";
const NEXT_AUDIT="2026-10-24";
const STALE_DAYS=90;

const TRIPWIRES=[
 /* BODY — Fiscal capacity */
 {id:1,layer:"BODY",name:"Federal Debt / GDP",now:63.1,trip:65,safe:50,unit:"%",dir:"above",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"Statutory ceiling 65% of GDP (temporary). RM1.2T total debt. Near tripwire by statute, not market."},
 {id:2,layer:"BODY",name:"Fiscal Deficit / GDP",now:3.8,trip:5.0,safe:2.0,unit:"%",dir:"above",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"Budget 2026 target 3.2%. Breaching 5% triggers rating review. Oil revenue = structural enabler."},
 {id:3,layer:"BODY",name:"Reserves (months of imports)",now:5.0,trip:3.0,safe:7.0,unit:"months",dir:"below",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"USD ~113B reserves (Bank Negara Q1 2026). 3 months = IMF minimum adequacy. 7 months = comfortable buffer."},

 /* ENGINE — Economic engine */
 {id:4,layer:"ENGINE",name:"Real GDP Growth",now:4.2,trip:2.0,safe:5.5,unit:"%",dir:"below",tag:"MIXED",sealed:"2026-07-24",
  note:"DOSM Q1 2026. Trend ~4–5% pre-pandemic. Below 2% = recessionary pressure. Above 5.5% = structural potential."},
 {id:5,layer:"ENGINE",name:"Current Account Balance / GDP",now:2.1,trip:-1.0,safe:4.0,unit:"%",dir:"below",tag:"MIXED",sealed:"2026-07-24",
  note:"27-year surplus streak. Commodity-driven. Below -1% of GDP = external vulnerability signal."},
 {id:6,layer:"ENGINE",name:"FDI / GDP (net inflows)",now:2.3,trip:1.0,safe:4.0,unit:"%",dir:"below",tag:"MIXED",sealed:"2026-07-24",
  note:"RM ~40B net FDI 2025. Below 1% = capital flight signal. Competes with Vietnam (~4.5%), Indonesia (~2%)."},

 /* SOUL — Institutions & demographics */
 {id:7,layer:"SOUL",name:"Old-Age Dependency Ratio",now:11.5,trip:15,safe:8.0,unit:"%",dir:"above",tag:"INTERPRET",sealed:"2026-07-24",
  note:"UN WPP 2024: population 65+ / 15–64. Malaysia aging faster than regional peers. Rising = structural fiscal drag."},
 {id:8,layer:"SOUL",name:"Corruption Perception Index",now:50,trip:35,safe:70,unit:"/100",dir:"below",tag:"INTERPRET",sealed:"2026-07-24",
  note:"Transparency International CPI 2025. 0=highly corrupt, 100=very clean. Singapore 84, Indonesia 37. BELOW direction = pain."},
 {id:9,layer:"SOUL",name:"Rule of Law (WGI Percentile)",now:68,trip:50,safe:85,unit:"%ile",dir:"below",tag:"INTERPRET",sealed:"2026-07-24",
  note:"World Bank WGI 2024. Percentile rank among ~210 countries. Below 50 = bottom half globally. Singapore ~95%ile."}
];

const WEIGHTS={BODY:0.40,ENGINE:0.35,SOUL:0.25};
const LAYER_LABELS={BODY:"BODY",ENGINE:"ENGINE",SOUL:"SOUL"};
const LAYER_VISIBLE={BODY:"Fiscal capacity",ENGINE:"Economic engine",SOUL:"Institutions & demographics"};

function score(t){
  const now=Math.round(t.now*10)/10, trip=Math.round(t.trip*10)/10, safe=Math.round(t.safe*10)/10;
  let s;
  if(t.dir==="below") s=(now-trip)/(safe-trip)*100;
  else                s=(trip-now)/(trip-safe)*100;
  return Math.max(0,Math.min(100,Math.round(s*10)/10));
}
function verdict(v){
  if(v>=80)return{w:"SEAL",c:"var(--seal)"};
  if(v>=60)return{w:"SABAR",c:"var(--sabar)"};
  if(v>=40)return{w:"HOLD",c:"var(--hold)"};
  return{w:"VOID",c:"var(--void)"};
}
function layerScore(L){
  const m=TRIPWIRES.filter(t=>t.layer===L);
  return Math.round(m.reduce((a,t)=>a+score(t),0)/m.length*10)/10;
}
const S={BODY:layerScore("BODY"),ENGINE:layerScore("ENGINE"),SOUL:layerScore("SOUL")};
const PULSE=Math.round((0.40*S.BODY+0.35*S.ENGINE+0.25*S.SOUL)*10)/10;

function daysSince(d){return Math.floor((Date.now()-new Date(d).getTime())/86400000);}
const sealAge=daysSince(SEAL_BASE);
document.getElementById("sealbadge").textContent=sealAge<=STALE_DAYS?"FRESH":"STALE";
document.getElementById("sealbadge").className="stale-tag "+(sealAge<=STALE_DAYS?"fresh":"stale");
document.getElementById("sealdate").textContent=SEAL_BASE;
document.getElementById("nextaudit").textContent=NEXT_AUDIT;

/* render hero — initial HTML values match JS-computed display (45 HOLD, 34/56/48) */
const pv=verdict(PULSE);
pulseval.textContent=PULSE.toFixed(0);
pulseverdict.textContent=pv.w;
pulseverdict.className="verdict-badge "+pv.w;
pulsefill.style.width=PULSE+"%";pulsefill.style.background=pv.c;
navdot.style.background=pv.c;
document.getElementById("malaysia-dot").style.background=pv.c;
function setSub(id,val){const v=verdict(val);const e=document.getElementById(id);e.textContent=val.toFixed(0);e.style.color=v.c;}
setSub("sb-body",S.BODY);setSub("sb-engine",S.ENGINE);setSub("sb-soul",S.SOUL);

/* render pillars — visible label via LAYER_VISIBLE, internal key preserved */
const pillarMeta={
  BODY:{sub:"fiscal capacity · EVIDENCE-grounded"},
  ENGINE:{sub:"economic engine · MIXED"},
  SOUL:{sub:"institutions & demographics · INTERPRET-grounded"}
};
const pillarsEl=document.getElementById("pillars-el");
["BODY","ENGINE","SOUL"].forEach(L=>{
  const ls=S[L],lv=verdict(ls);
  const rows=TRIPWIRES.filter(t=>t.layer===L).map(t=>{
    const sc=score(t),v=verdict(sc),sd=daysSince(t.sealed);
    const staleHtml=sd>STALE_DAYS?`<span class="stale-tag stale">STALE ${sd}d</span>`:`<span class="stale-tag fresh">sealed ${t.sealed}</span>`;
    return `<div class="lung-row">
      <div class="name">${t.id}. ${t.name} <span class="epi-tag-small ${t.tag}">${t.tag}</span></div>
      <div class="nums">now <b>${t.now}${t.unit}</b> · trip ${t.dir==="below"?"&lt;":">"}${t.trip}${t.unit} · safe ${t.safe}${t.unit}</div>
      <div class="mini-bar"><div class="mini-fill" style="width:${sc}%;background:${v.c}"></div></div>
      <div class="mini-labels"><span style="color:${v.c}">${v.w} · ${sc.toFixed(0)}/100</span><span>${t.note}</span></div>
      <div class="seal">${staleHtml}</div>
    </div>`;
  }).join("");
  const el=document.createElement("div");
  el.className="lung";
  el.innerHTML=`<div class="lung-head">
      <div class="lung-name">${LAYER_VISIBLE[L]}<small>${pillarMeta[L].sub}</small></div>
      <div class="lung-light" style="background:${lv.c}22;color:${lv.c}">${ls.toFixed(0)}</div>
    </div><div class="lung-body">${rows}</div>`;
  el.querySelector(".lung-head").onclick=()=>el.classList.toggle("open");
  pillarsEl.appendChild(el);
});

/* render 9 tripwire grid — full threshold labels: now · trip · safe */
const g=document.getElementById("grid9");
TRIPWIRES.forEach(t=>{
  const sc=score(t),v=verdict(sc),sd=daysSince(t.sealed);
  const tense=sc<=25?"tense":"";
  const staleCls=sd>STALE_DAYS?" stale-cell":"";
  const c=document.createElement("div");
  c.className="tripcell "+tense+staleCls;
  const staleTag=sd>STALE_DAYS?`<span style="color:var(--hold);font-size:8px"> ⚠ STALE ${sd}d</span>`:"";
  c.innerHTML=`<div class="idx mono">#${t.id}</div>
    <div class="title">${t.name}</div><div class="layer">${LAYER_VISIBLE[t.layer]} · ${t.tag}${staleTag}</div>
    <div class="gauge"><div class="gauge-fill" style="width:${sc}%;background:${v.c}"></div><div class="gauge-trip" style="left:2%"></div></div>
    <div class="metrics"><span>now <b>${t.now}${t.unit}</b></span><span>trip ${t.dir==="below"?"&lt;":">"}${t.trip}${t.unit}</span><span>safe ${t.safe}${t.unit}</span></div>
    <div class="verdict" style="color:${v.c}">${v.w} · ${sc<=25?"⚠ near trip":sc.toFixed(0)+"/100"}</div>
    <div class="seal-date">sealed ${t.sealed}</div>`;
  g.appendChild(c);
});
</script>

