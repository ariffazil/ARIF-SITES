<!-- WHAT-IF TOOL · v3 LIVE PARADOX MODEL -->
<section class="sec" id="whatif" data-agent-role="scenario" aria-labelledby="whatif-title">
  <div class="sec-title" id="whatif-title">What if oil moves? <span class="epi-tag-small INTERPRET">INTERPRET</span> · v3 live model</div>
  <p style="font-size:12px;color:var(--dim);max-width:76ch;line-height:1.6">Drag the sliders below — the engine recomputes the federal subsidy bill, petroleum dividend, hidden tax ratio, and Tripwire 10 in real time. Sealed sovereign anchors never change. <b>This is a sensitivity simulation with stated transmission rules, not a forecast.</b></p>

  <!-- 4-slider sovereign version (Brent + Iran war + reform delay + USD/MYR) -->
  <div style="background:var(--surface2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;margin:0 0 16px">
    <div style="font-family:var(--mono);font-size:11px;color:var(--accent);letter-spacing:.06em;text-transform:uppercase;margin-bottom:10px">⚙ Sovereign sliders · drag for live path</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px,1fr));gap:14px;margin-bottom:14px">
      <div class="slider"><label style="font-family:var(--mono);font-size:10px;color:var(--dim)">Brent crude <b id="mv-brentv" style="color:var(--accent)">65</b> $/bbl</label>
        <input type="range" min="40" max="125" step="1" value="65" id="mv-brent" style="width:100%"></div>
      <div class="slider"><label style="font-family:var(--mono);font-size:10px;color:var(--dim)">USD/MYR <b id="mv-myrv" style="color:var(--accent)">4.10</b></label>
        <input type="range" min="3.8" max="4.8" step="0.01" value="4.10" id="mv-myr" style="width:100%"></div>
      <div class="slider" style="background:rgba(255,255,255,.02);padding:8px 10px;border-radius:6px"><label style="font-family:var(--mono);font-size:10px;color:var(--void)">⚠ Iran war persistence <b id="mv-iranv" style="color:var(--void)">0</b>%</label>
        <input type="range" min="0" max="100" step="5" value="0" id="mv-iran" style="width:100%"></div>
      <div class="slider" style="background:rgba(255,255,255,.02);padding:8px 10px;border-radius:6px"><label style="font-family:var(--mono);font-size:10px;color:var(--void)">⚠ Subsidy reform delay <b id="mv-delayv" style="color:var(--void)">0</b> months</label>
        <input type="range" min="0" max="24" step="1" value="0" id="mv-delay" style="width:100%"></div>
    </div>

    <!-- Live sovereign readouts -->
    <div style="background:var(--surface3);border:1px solid var(--line);border-radius:8px;padding:14px;margin:0 0 12px">
      <div style="font-family:var(--mono);font-size:10px;color:var(--accent);letter-spacing:.06em;margin-bottom:8px">📊 SOVEREIGN LIVE READOUT · year-1</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(110px,1fr));gap:10px;font-family:var(--mono);font-size:11px">
        <div><div style="color:var(--dim);font-size:9px">PETRONAS dividend</div><div id="mv-div" style="color:var(--ink);font-weight:700;font-size:14px">–</div></div>
        <div><div style="color:var(--dim);font-size:9px">Subsidy bill</div><div id="mv-sub" style="color:var(--void);font-weight:700;font-size:14px">–</div></div>
        <div><div style="color:var(--dim);font-size:9px">Net to budget</div><div id="mv-net" style="color:var(--ink);font-weight:700;font-size:14px">–</div></div>
        <div><div style="color:var(--dim);font-size:9px">Hidden tax ratio</div><div id="mv-htr" style="color:var(--void);font-weight:700;font-size:14px">–</div></div>
      </div>
      <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--line);font-family:var(--mono);font-size:11px">
        <div id="mv-trip10" style="padding:3px 10px;border-radius:4px;font-weight:700;font-size:10px;letter-spacing:.04em;display:inline-block">TRIPWIRE 10 STANDBY</div>
      </div>
    </div>

    <!-- Sovereign chart -->
    <canvas id="mv-canvas" width="1040" height="320" style="width:100%;max-width:1040px;height:auto;display:block;border:1px solid var(--line);border-radius:6px;background:var(--surface3)"></canvas>
    <div style="font-family:var(--mono);font-size:9px;color:var(--faint);margin-top:6px;line-height:1.5">
      Lines: <span style="color:#4aa8ff">■</span> PETRONAS dividend · <span style="color:#f0506e">■</span> Subsidy bill · <span style="color:#e3b341">■</span> Net to budget. Tripwire 10 fires when subsidy exceeds dividend. v3 model.
    </div>

    <!-- Human-language verdict -->
    <div id="mv-readout" style="margin-top:14px;padding:14px 16px;background:var(--surface3);border:2px solid var(--accent);border-radius:8px">
      <div style="font-family:var(--mono);font-size:11px;letter-spacing:.06em;margin-bottom:6px">
        <span style="color:var(--dim)">SOVEREIGN VERDICT · </span>
        <span id="mv-verdict" style="font-weight:700;font-size:13px;color:var(--seal)">STABLE</span>
      </div>
      <div id="mv-headline" style="font-size:13px;color:var(--ink);line-height:1.5;font-weight:500">–</div>
    </div>
  </div>

</section>

<script>
/* v3 Sovereign live engine — same model as /propa/ but with sovereign framing */
(function(){
  const V3 = {
    BASE: { revenue: 266.1, pat: 45.4, cffo: 85.2, capex: 41.6, dividend: 32.0, net_cash_start: 82.8, prefchem_debt: 35.0 },
    DIVIDEND_CAP_PCT: 0.60, MOF_FLOOR: 20.0, SUBSIDY_HARD_CEILING: 75.0,
    pat(p) {
      const d_brent = (p.brent || 85) - 85;
      const d_fx = ((p.fx || 4.10) - 4.10) * 10;
      const delta = d_brent * 1.00 + d_fx * 0.40;
      return Math.round(Math.max(0, (45.4 + delta)) * 10) / 10;
    },
    div(pat) { return Math.round(Math.max(this.MOF_FLOOR, pat * this.DIVIDEND_CAP_PCT) * 10) / 10; },
    sub(p) {
      const brent = p.brent || 85, iran = p.iran_war || 0, delay = p.reform_delay_months || 0;
      let base;
      if (brent <= 50) base = 3.0 + (brent - 40) * 0.5;
      else if (brent <= 65) base = 8.0 + (brent - 50) * 0.467;
      else if (brent <= 90) base = 15.0 + (brent - 65) * 1.5;
      else base = 52.5 + (brent - 90) * 0.571;
      const iu = 1.0 + 0.10 * (iran / 50.0);
      const ru = 1.0 + 0.02 * delay;
      return Math.round(Math.min(base * iu * ru, this.SUBSIDY_HARD_CEILING) * 10) / 10;
    },
    rev(p) {
      const brent = p.brent || 85;
      const r = brent <= 60 ? 60.0 - (60 - brent) * 0.3 : 60.0 + (brent - 60) * 0.5;
      return Math.round(Math.max(0, r) * 10) / 10;
    },
    net(p) { return Math.round((this.rev(p) - this.sub(p)) * 10) / 10; },
    htr(p) { const d = this.div(this.pat(p)); const s = this.sub(p); return d > 0 ? Math.round((s/d) * 100) / 100 : null; },
    t10(p) { const d = this.div(this.pat(p)); const s = this.sub(p); return d > 0 && (s/d) > 1.0; }
  };

  const sels = ['brent','myr','iran','delay'].reduce((a, k) => { a[k] = document.getElementById('mv-'+k); return a; }, {});
  const vels = ['brent','myr','iran','delay'].reduce((a, k) => { a[k] = document.getElementById('mv-'+k+'v'); return a; }, {});
  const r_div = document.getElementById('mv-div'), r_sub = document.getElementById('mv-sub'),
        r_net = document.getElementById('mv-net'), r_htr = document.getElementById('mv-htr'),
        r_t10 = document.getElementById('mv-trip10'),
        r_verdict = document.getElementById('mv-verdict'),
        r_headline = document.getElementById('mv-headline');
  const cv = document.getElementById('mv-canvas'), cx = cv.getContext('2d');
  const YEARS = [2025, 2026, 2027, 2028, 2029, 2030, 2031];

  function params() {
    return { brent: +sels.brent.value, fx: +sels.myr.value, iran_war: +sels.iran.value, reform_delay_months: +sels.delay.value };
  }

  function drawChart(p) {
    const W = cv.width, H = cv.height, pad = 56;
    cx.clearRect(0, 0, W, H);
    function ySeries(fn) { const out = []; for (let i = 0; i < YEARS.length; i++) out.push(fn(p, i)); return out; }
    const subLine = ySeries(() => V3.sub(p));
    const divLine = ySeries(() => V3.div(V3.pat(p)));
    const netLine = ySeries(() => V3.net(p));
    const all = [...subLine, ...divLine, ...netLine, 90, -10];
    const max = Math.max(...all), min = Math.min(...all, -10);
    const x = i => pad + (W - pad * 1.6) * i / (YEARS.length - 1);
    const y = v => pad / 2 + (H - pad * 1.5) * (max - v) / (max - min);
    cx.strokeStyle = '#161d28'; cx.lineWidth = 1; cx.fillStyle = '#5a6675'; cx.font = '10px monospace';
    for (let s = 0; s <= 5; s++) {
      const v = max - (max - min) * s / 5, yy = y(v);
      cx.beginPath(); cx.moveTo(pad, yy); cx.lineTo(W - pad * 0.4, yy); cx.stroke();
      cx.fillText(Math.round(v) + 'B', 4, yy + 4);
    }
    cx.strokeStyle = '#3a3f4b'; cx.setLineDash([3, 3]);
    cx.beginPath(); cx.moveTo(pad, y(0)); cx.lineTo(W - pad * 0.4, y(0)); cx.stroke();
    cx.setLineDash([]);
    cx.fillStyle = '#7a8698'; cx.font = '11px monospace';
    cx.fillText('RM B · year-by-year · sovereign · v3 model', pad, pad / 2 - 12);
    YEARS.forEach((yr, i) => { cx.fillStyle = '#5a6675'; cx.fillText(yr, x(i) - 14, H - pad + 16); });
    function line(arr, color, w) {
      cx.strokeStyle = color; cx.lineWidth = w;
      cx.beginPath(); arr.forEach((v, i) => i ? cx.lineTo(x(i), y(v)) : cx.moveTo(x(i), y(v)));
      cx.stroke();
      arr.forEach((v, i) => { cx.fillStyle = color; cx.beginPath(); cx.arc(x(i), y(v), 2.5, 0, 7); cx.fill(); });
    }
    line(divLine, '#4aa8ff', 2);   // PETRONAS dividend (sovereign inflow)
    line(subLine, '#f0506e', 2);   // subsidy bill (sovereign cost)
    line(netLine, '#e3b341', 2.5); // net to budget (sovereign position)
    cx.fillStyle = '#e3b341'; cx.beginPath(); cx.arc(x(1), y(netLine[1]), 6, 0, 7); cx.fill();
    cx.strokeStyle = 'rgba(227,179,65,0.4)'; cx.lineWidth = 2; cx.beginPath(); cx.arc(x(1), y(netLine[1]), 10, 0, 7); cx.stroke();
    const lx = W - pad * 0.4 - 200, ly = pad / 2;
    cx.font = '10px monospace';
    [{c:'#4aa8ff',l:'Dividend'},{c:'#f0506e',l:'Subsidy'},{c:'#e3b341',l:'Net budget'}].forEach((l, i) => { cx.fillStyle = l.c; cx.fillRect(lx, ly + i * 14, 10, 10); cx.fillStyle = '#d8d2c4'; cx.fillText(l.l, lx + 14, ly + i * 14 + 9); });
  }

  function live() {
    const p = params();
    vels.brent.textContent = p.brent;
    vels.myr.textContent = p.fx.toFixed(2);
    vels.iran.textContent = p.iran_war;
    vels.delay.textContent = p.reform_delay_months;
    const pat = V3.pat(p), div = V3.div(pat), sub = V3.sub(p), rev = V3.rev(p);
    const net = Math.round((rev-sub)*10)/10, htr = V3.htr(p), t10 = V3.t10(p);
    r_div.textContent = 'RM' + div.toFixed(1) + 'B';
    r_sub.textContent = 'RM' + sub.toFixed(1) + 'B';
    r_net.textContent = (net >= 0 ? '+' : '') + 'RM' + net.toFixed(1) + 'B';
    r_net.style.color = net >= 0 ? 'var(--seal)' : 'var(--void)';
    r_htr.textContent = htr != null ? htr.toFixed(2) + '×' : '–';
    r_htr.style.color = htr && htr > 1 ? 'var(--void)' : (htr && htr > 0.5 ? 'var(--sabar)' : 'var(--seal)');
    if (t10) {
      r_t10.textContent = '⚠ TRIPWIRE 10 ENGAGED — subsidy > petroleum dividend';
      r_t10.style.background = 'var(--void)';
      r_t10.style.color = '#fff';
      r_verdict.textContent = 'PARADOX';
      r_verdict.style.color = 'var(--void)';
      r_headline.textContent = `Brent $${p.brent} · subsidy RM${sub.toFixed(1)}B exceeds petroleum dividend. Federal net position compressed or negative.`;
    } else if (htr && htr > 0.7) {
      r_verdict.textContent = 'TIGHT';
      r_verdict.style.color = 'var(--sabar)';
      r_t10.textContent = 'TRIPWIRE 10 STANDBY (ratio ' + htr.toFixed(2) + '×)';
      r_t10.style.background = 'transparent';
      r_t10.style.color = 'var(--sabar)';
      r_headline.textContent = `Brent $${p.brent} · subsidy approaching dividend. Hidden tax ratio ${htr.toFixed(2)}×.`;
    } else {
      r_verdict.textContent = 'STABLE';
      r_verdict.style.color = 'var(--seal)';
      r_t10.textContent = 'TRIPWIRE 10 STANDBY';
      r_t10.style.background = 'transparent';
      r_t10.style.color = 'var(--dim)';
      r_headline.textContent = `Brent $${p.brent} · manageable. Net to budget RM${net.toFixed(1)}B.`;
    }
    drawChart(p);
  }

  ['brent','myr','iran','delay'].forEach(k => sels[k].addEventListener('input', live));
  live();
})();
</script>

