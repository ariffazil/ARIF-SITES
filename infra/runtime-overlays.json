{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 2,
  "registry": "arif-fazil.com.runtime-overlays.v2",
  "canonical_repo_root": "/root/arif-sites",
  "doctrine": "One domain. One web surface. Many organs, tetap bersempadan. Subdomain lama jangan dibuang \u2014 jadikan saksi dan redirect.",
  "defaults": {
    "probe_attempts": 3,
    "caddy_attempts": 3,
    "retry_delay_seconds": 2
  },
  "sites": [
    {
      "site": "_shared",
      "source": "sites/shared",
      "webroot": "_shared",
      "owner": "arif-sites",
      "batch": true,
      "batch_order": 10,
      "required_artifacts": [
        "design-system/tokens.css",
        "trinity-nav.js",
        "webmcp/arifos-webmcp-adapter.js"
      ],
      "probe": {
        "url": "https://arif-fazil.com/_shared/trinity-nav.js",
        "accepted_codes": [
          200
        ]
      },
      "overlays": [],
      "aliases": [
        "_shared"
      ]
    },
    {
      "site": "arif-fazil.com",
      "source": "sites/arif-fazil.com",
      "webroot": "arif",
      "owner": "arif-sites",
      "batch": true,
      "batch_order": 20,
      "build": {
        "kind": "npm",
        "install": [
          "npm",
          "ci",
          "--quiet",
          "--legacy-peer-deps"
        ],
        "command": [
          "npm",
          "run",
          "build"
        ],
        "output": "dist"
      },
      "required_artifacts": [
        "index.html",
        "000/index.html",
        "work/proof/index.html"
      ],
      "probe": {
        "url": "https://arif-fazil.com/",
        "accepted_codes": [
          200
        ]
      },
      "overlays": [
        {
          "path": "static/wealth.html",
          "owner": "wealth-briefing-cron",
          "strategy": "preserve-live",
          "note": "2026-07-27: rendered daily 06:00 UTC by /root/scripts/wealth-briefing-cron.sh from live latest.json; deploy must never clobber (888 auth)"
        },
        {
          "path": "data/wealth",
          "owner": "wealth-briefing-cron",
          "strategy": "preserve-live",
          "note": "2026-07-27: latest.json + 50-day archive are cron-maintained; deploy must never clobber (888 auth)"
        }
      ],
      "aliases": [
        "arif-fazil.com"
      ]
    },
    {
      "site": "arifos",
      "source": "sites/arif-fazil.com/public/arifos",
      "webroot": "arifos",
      "owner": "arif-sites",
      "unified_path": "/arifos/",
      "legacy_subdomain": "arifos.arif-fazil.com",
      "batch": true,
      "batch_order": 30,
      "required_artifacts": [
        "index.html",
        "llms.txt"
      ],
      "probe": {
        "url": "https://arif-fazil.com/arifos/",
        "accepted_codes": [
          200
        ]
      },
      "overlays": [
        {
          "path": ".well-known/observatory-snapshot-latest.json",
          "owner": "arifos-observatory-publisher",
          "strategy": "preserve-live"
        },
        {
          "path": ".well-known/observatory_signing_key.pub.pem",
          "owner": "arifos-observatory-publisher",
          "strategy": "preserve-live"
        },
        {
          "path": ".well-known/did-arifos-observatory.json",
          "owner": "arifos-observatory-publisher",
          "strategy": "preserve-live"
        },
        {
          "path": ".well-known/did.json",
          "owner": "arifos-observatory-publisher",
          "strategy": "preserve-live"
        },
        {
          "path": ".well-known/governance.jsonld",
          "owner": "arifos-governance-runtime",
          "strategy": "preserve-live"
        },
        {
          "path": "manifest.txt",
          "owner": "aaa-manifest-publisher",
          "strategy": "preserve-live"
        },
        {
          "path": "federation-manifest.json",
          "owner": "arif-sites",
          "strategy": "merge-source-wins"
        },
        {
          "path": "zen",
          "owner": "arifos-zen-publisher",
          "strategy": "preserve-live"
        }
      ],
      "aliases": [
        "arifos",
        "arifos.arif-fazil.com"
      ]
    },
