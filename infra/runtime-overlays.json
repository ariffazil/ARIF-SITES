      "owner": "arif-sites",
      "unified_path": "/wiki/",
      "legacy_subdomain": "wiki.arif-fazil.com",
      "batch": true,
      "batch_order": 100,
      "build": {
        "kind": "mkdocs",
        "command": [
          "mkdocs",
          "build",
          "--strict",
          "--config-file",
          "mkdocs.yml",
          "--site-dir",
          "site"
        ],
        "output": "site",
        "pinned": true,
        "version_command": [
          "mkdocs",
          "--version"
        ],
        "version_contains": "1.6.1",
        "output_markers": [
          {
            "path": "index.html",
            "contains": "mkdocs-1.6.1, mkdocs-material-9.7.7"
          }
        ]
      },
      "required_artifacts": [
        "index.html",
        "sitemap.xml"
