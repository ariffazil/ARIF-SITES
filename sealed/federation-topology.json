{
  "schema": "arifos.federation.topology.v1",
  "as_of": "2026-07-31",
  "sealed_by": "Muhammad Arif bin Fazil (F13 SOVEREIGN)",
  "doctrine": "Single source of truth for arif-fazil.com surface catalog. Update this file to add/remove/rename surfaces. All discovery artifacts (sitemap.xml, llms.txt, llms.json, page.json) auto-generate from this file via generate-discovery.cjs at build time.",
  "federation_root": {
    "domain": "arif-fazil.com",
    "spa_webroot": "/var/www/html/arif",
    "source_repo": "/root/arif-fazil.com",
    "static_webroot_for_makcikgpt": "/var/www/html/arif/makcikgpt-md"
  },
  "machine_surfaces": {
    "sitemap_xml":          { "path": "/sitemap.xml",         "kind": "seo",      "changefreq": "daily",   "priority": 0.7, "rendered_by": "generate-discovery.cjs" },
    "llms_txt":             { "path": "/llms.txt",            "kind": "agent_llm","changefreq": "weekly",  "priority": 0.5, "rendered_by": "generate-discovery.cjs" },
    "llms_json":            { "path": "/llms.json",           "kind": "agent_llm","changefreq": "weekly",  "priority": 0.7, "rendered_by": "generate-discovery.cjs" },
    "page_json":            { "path": "/page.json",           "kind": "agent_llm","changefreq": "weekly",  "priority": 0.5, "rendered_by": "generate-discovery.cjs" },
    "missions_json":        { "path": "/missions.json",       "kind": "cockpit",  "changefreq": "weekly",  "priority": 0.9, "rendered_by": "hand_curated_then_synced" },
    "llms_full_txt":        { "path": "/llms-full.txt",       "kind": "agent_llm","changefreq": "monthly", "priority": 0.3, "rendered_by": "build" },
    "feed_xml":             { "path": "/feed.xml",            "kind": "rss",      "changefreq": "daily",   "priority": 0.4, "rendered_by": "generate-feed.cjs" },
    "human_md":             { "path": "/human.md",            "kind": "agent_llm","changefreq": "monthly", "priority": 0.3 },
    "agents_md":            { "path": "/AGENTS.md",           "kind": "agent_llm","changefreq": "monthly", "priority": 0.3 },
    "ns_live_telemetry":    { "path": "/data/politics/ns_live_telemetry.json", "kind": "live_audit", "changefreq": "hourly", "priority": 0.4, "rendered_by": "generate-ns-telemetry.cjs (cron every 15min offset :07/:22/:37/:52)" },
    "authority_json":       { "path": "/authority.json",      "kind": "governance","changefreq": "monthly","priority": 0.3 },
    "policy_json":          { "path": "/policy.json",         "kind": "governance","changefreq": "monthly","priority": 0.3 },
    "graph_json":           { "path": "/graph.json",          "kind": "knowledge","changefreq": "weekly", "priority": 0.4 },
    "manifest_json":        { "path": "/manifest.json",       "kind": "governance","changefreq": "monthly","priority": 0.3 },
    "robots_txt":           { "path": "/robots.txt",          "kind": "seo",      "changefreq": "yearly", "priority": 0.2 }
  },
  "human_surfaces": {
