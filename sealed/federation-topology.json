  "missions": {
    "schema": "arifos.missions.v1",
    "doctrine_title": "Six missions. Not 128 tools.",
    "verbs": ["Investigate", "Interpret", "Decide", "Build", "Monitor", "Remember"],
    "surfaces_per_mission": {
      "Investigate": ["/earth", "/economics", "https://arifos.arif-fazil.com", "/politics/ns-election/"],
      "Interpret":   ["/earth", "/world/makcikgpt", "/economics"],
      "Decide":      ["/doctrine", "/institution", "/999/", "/politics/ns-election/playbook/"],
      "Build":       ["/000/", "https://forge.arif-fazil.com"],
      "Monitor":     ["/politics/ns-election/", "https://well.arif-fazil.com"],
      "Remember":    ["/999/", "/writing", "https://mcp.arif-fazil.com"]
    }
  },
  "freshness_hierarchy": {
    "explanation": "When federated surfaces show different timestamps, this is the precedence order — newer overrides older.",
    "tiers": [
      { "tier": 1, "label": "live_runtime",       "example": "/data/politics/ns_live_telemetry.json",       "refresh": "every 15 min via cron" },
      { "tier": 2, "label": "sealed_sovereign",   "example": "/sealed/n9-ground-truth.json",                 "refresh": "F13 action only" },
      { "tier": 3, "label": "federation_topology","example": "/sealed/federation-topology.json",              "refresh": "F13 action only" },
      { "tier": 4, "label": "build_generated",    "example": "/sitemap.xml, /llms.json, /page.json",        "refresh": "on every npm run build" },
      { "tier": 5, "label": "hand_curated",       "example": "/missions.json, Home.tsx, ConstellationNav",   "refresh": "manual + reviewed" }
    ]
  },
  "operational_signals": {
    "telemetry_cron": {
      "schedule": "7,22,37,52 * * * *",
      "user": "root (deferred: dedicated service account)",
      "command": "cd /root/arif-fazil.com/sites/arif-fazil.com/scripts && /usr/bin/node generate-ns-telemetry.cjs >> /var/log/ns-telemetry.log 2>&1",
      "log": "/var/log/ns-telemetry.log"
    }
  }
