<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>PETRONAS · φ VITALS — Exteroception Organ</title>
<meta name="description" content="Unified PETRONAS financial modeling toolkit. Composite pulse index, 9 tripwires with dated seals, sensitivity coefficients, forward trajectory fan chart.">
<link rel="canonical" href="https://arif-fazil.com/vitals/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Mono:wght@300;400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0c10; --panel:#11151c; --panel2:#151b24; --line:#1f2733;
  --ink:#e6edf3; --dim:#8b98a8; --faint:#5a6675;
  --seal:#31c48d; --sabar:#e3b341; --hold:#e8833a; --void:#f0506e;
  --accent:#4aa8ff; --mono:'IBM Plex Mono','SF Mono',ui-monospace,'Cascadia Code',Menlo,Consolas,monospace;
  --display:'DM Serif Display',Georgia,serif;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;line-height:1.5;padding-bottom:80px}
.mono{font-family:var(--mono)}
.disp{font-family:var(--display)}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}

/* ZEN PULSE */
.zen-pulse{position:sticky;top:0;z-index:30;background:rgba(10,12,16,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:2rem;padding:0.55rem 2rem;font-size:0.72rem;font-family:var(--mono);overflow-x:auto;white-space:nowrap}
.zp-item{display:flex;gap:0.5rem;align-items:center}
.zp-ask{color:var(--faint)}
.zp-val{color:var(--sabar);font-weight:500}
.pulsedot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;animation:zen 2.4s ease-in-out infinite}
@keyframes zen{0%,100%{opacity:.35;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}
.navlinks{margin-left:auto;display:flex;gap:14px}
.navlinks a{color:var(--dim);text-decoration:none;font-size:11px;transition:color .15s}
.navlinks a:hover,.navlinks a.here{color:var(--ink)}

/* HERO */
.hero{padding:28px 0 10px}
.tagline{font-family:var(--mono);color:var(--faint);font-size:11px;letter-spacing:1.2px;text-transform:uppercase}
h1{font-family:var(--display);font-size:24px;font-weight:400;margin:4px 0 6px;color:#fff}
h1 span{color:var(--accent)}
h1 .pulse-tag{font-family:var(--mono);font-size:8px;font-weight:700;padding:2px 8px;border-radius:4px;letter-spacing:.5px;margin-left:10px;background:rgba(227,179,65,.18);color:var(--sabar);vertical-align:middle;position:relative;top:-2px}
.pulsebar-wrap{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px}
.pulsehead{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:10px}
.pulseval{font-family:var(--mono);font-size:52px;font-weight:700;line-height:1}
.verdictword{font-family:var(--mono);font-size:16px;font-weight:700;padding:4px 14px;border-radius:20px;letter-spacing:1.5px}
.qoq{font-family:var(--mono);font-size:12px;color:var(--dim)}
.lastseal{font-family:var(--mono);font-size:10px;color:var(--faint);margin-top:6px}
.stale-badge{font-family:var(--mono);font-size:8px;font-weight:700;padding:2px 6px;border-radius:3px;margin-left:6px}
.stale-badge.fresh{background:rgba(49,196,141,.12);color:var(--seal)}
.stale-badge.stale{background:rgba(232,131,58,.15);color:var(--hold);animation:stalePulse 3s ease-in-out infinite}
@keyframes stalePulse{0%,100%{opacity:.6}50%{opacity:1}}
.bar{height:14px;border-radius:8px;background:var(--panel2);margin-top:18px;overflow:hidden;position:relative;border:1px solid var(--line)}
.barfill{height:100%;border-radius:8px;transition:width .8s cubic-bezier(.2,.8,.2,1)}
.bands{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:var(--faint);margin-top:6px}
.subscores{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}
.sub{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:14px}
.sub .lab{font-family:var(--mono);font-size:11px;color:var(--dim);letter-spacing:.5px}
.sub .val{font-family:var(--mono);font-size:24px;font-weight:700;margin-top:3px}
.sub .wt{font-family:var(--mono);font-size:10px;color:var(--faint);margin-top:2px}
.sub .subtag{font-family:var(--mono);font-size:7px;font-weight:700;padding:1px 5px;border-radius:3px;display:inline-block;margin-top:4px}

/* SECTIONS */
.sec{margin-top:34px}
.sectitle{font-family:var(--mono);font-size:12px;color:var(--dim);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:10px}
.sectitle::after{content:"";flex:1;height:1px;background:var(--line)}

/* VERB CTAs */
.verb-cta{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 0}
.verb-cta a{font-family:var(--mono);font-size:10px;color:var(--dim);text-decoration:none;padding:5px 14px;border:1px solid var(--line);border-radius:20px;transition:all .2s}
.verb-cta a:hover{color:var(--ink);border-color:var(--accent);background:rgba(74,168,255,.06)}

/* LUNGS */
.lungs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.lung{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.lunghead{padding:14px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;user-select:none}
.lunghead:hover{background:var(--panel2)}
.lungname{font-family:var(--mono);font-size:13px;font-weight:600}
.lungname small{display:block;color:var(--faint);font-size:10px;font-weight:400;margin-top:2px}
.lunglight{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-weight:700;font-size:14px;flex-shrink:0}
.lungbody{max-height:0;overflow:hidden;transition:max-height .4s ease;border-top:1px solid transparent}
.lung.open .lungbody{max-height:700px;border-top-color:var(--line)}
.metricrow{padding:12px 14px;border-bottom:1px solid var(--line)}
.metricrow:last-child{border-bottom:none}
.metrictop{display:flex;justify-content:space-between;align-items:baseline;gap:6px}
.metricname{font-size:12px;color:var(--ink)}
.tag{font-family:var(--mono);font-size:7px;font-weight:700;padding:1px 5px;border-radius:3px;letter-spacing:.4px;flex-shrink:0}
.tag.EVIDENCE{background:rgba(49,196,141,.14);color:var(--seal)}
.tag.INTERPRET{background:rgba(227,179,65,.14);color:var(--sabar)}
.tag.UNKNOWN{background:rgba(90,102,117,.18);color:var(--faint)}
.metricnums{font-family:var(--mono);font-size:10px;color:var(--dim);margin-top:5px}
.dtt{margin-top:6px;height:6px;border-radius:4px;background:var(--panel2);position:relative;border:1px solid var(--line)}
.dttfill{height:100%;border-radius:4px}
.dttlabel{font-family:var(--mono);font-size:9px;color:var(--faint);margin-top:4px;display:flex;justify-content:space-between}
.metricseal{font-family:var(--mono);font-size:8px;color:var(--faint);margin-top:3px}

/* TRIPWIRE GRID */
.grid9{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.cell{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;position:relative}
.cell .idx{position:absolute;top:10px;right:12px;font-family:var(--mono);font-size:10px;color:var(--faint)}
.cell .cn{font-size:12px;font-weight:600;padding-right:20px}
.cell .cl{font-family:var(--mono);font-size:8px;color:var(--faint);letter-spacing:.5px;margin-top:2px}
.gauge{margin-top:10px;height:8px;border-radius:5px;background:var(--panel2);position:relative;overflow:hidden;border:1px solid var(--line)}
.gaugefill{height:100%;border-radius:5px}
.gaugetrip{position:absolute;top:-2px;width:2px;height:12px;background:var(--void)}
.cellnums{font-family:var(--mono);font-size:10px;color:var(--dim);margin-top:8px;display:flex;justify-content:space-between}
.cellverdict{font-family:var(--mono);font-size:10px;font-weight:700;margin-top:6px}
.cellseal{font-family:var(--mono);font-size:8px;color:var(--faint);margin-top:3px}
.tense{animation:tense 1.4s ease-in-out infinite}
@keyframes tense{0%,100%{box-shadow:0 0 0 0 rgba(240,80,110,0)}50%{box-shadow:0 0 0 3px rgba(240,80,110,.22)}}
.stale-cell{border-color:rgba(232,131,58,.25)!important}

/* SENSITIVITY TABLE */
.senstable{width:100%;border-collapse:collapse;font-size:0.78rem;font-family:var(--mono);margin-top:6px}
.senstable th{text-align:left;padding:0.5rem 0.8rem;color:var(--faint);font-size:0.65rem;text-transform:uppercase;letter-spacing:.06em;border-bottom:2px solid var(--line);background:var(--panel2)}
.senstable td{padding:0.45rem 0.8rem;border-bottom:1px solid var(--line);color:var(--dim)}
.senstable td.num{text-align:right;color:var(--ink);font-weight:500;font-variant-numeric:tabular-nums}
.senstable td.impact{text-align:right;font-weight:600}
.senstable tr:hover td{background:var(--panel2)}
.senstable .section-row td{color:var(--sabar);font-weight:600;font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;padding-top:.8rem;border-bottom:1px solid var(--line)}

/* REFPANEL */
.refpanel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:14px}
.refpanel h4{font-family:var(--mono);font-size:11px;color:var(--dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:14px}
.reftable{width:100%;border-collapse:collapse;font-size:0.75rem;font-family:var(--mono)}
.reftable th{text-align:left;padding:0.45rem 0.8rem;color:var(--faint);font-size:0.65rem;text-transform:uppercase;letter-spacing:.06em;border-bottom:2px solid var(--line)}
.reftable td{padding:0.4rem 0.8rem;border-bottom:1px solid var(--line);color:var(--dim)}
.reftable td.num{text-align:right;color:var(--ink);font-weight:500}

/* FAN */
.fanwrap{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px}
.sliders{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:18px}
.slider label{font-family:var(--mono);font-size:11px;color:var(--dim);display:flex;justify-content:space-between}
.slider label b{color:var(--accent);font-size:14px}
input[type=range]{width:100%;margin-top:8px;accent-color:var(--accent);height:4px}
.readout{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
.ro{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px;text-align:center}
.ro .l{font-family:var(--mono);font-size:10px;color:var(--faint)}
.ro .v{font-family:var(--mono);font-size:20px;font-weight:700;margin-top:3px}
canvas{width:100%;height:auto;display:block;margin-top:8px}
.legend{display:flex;gap:18px;flex-wrap:wrap;font-family:var(--mono);font-size:10px;color:var(--dim);margin-top:12px}
.legend span{display:inline-flex;align-items:center;gap:5px}
.dot{width:10px;height:3px;border-radius:2px;display:inline-block}

/* MODELING BASICS */
details.zen-reveal{margin:0.85rem 0;background:var(--panel);border:1px solid var(--line);border-radius:8px}
details.zen-reveal summary{padding:0.7rem 1rem;cursor:pointer;font-family:var(--mono);font-size:0.78rem;color:var(--sabar);user-select:none}
details.zen-reveal .reveal-body{padding:0 1rem 1.2rem;font-size:0.8rem;color:var(--dim);line-height:1.7}
.reveal-body h5{color:var(--ink);font-family:var(--mono);font-size:0.78rem;margin:12px 0 4px}
.reveal-body code{background:var(--panel2);padding:1px 5px;border-radius:3px;font-family:var(--mono);font-size:0.72rem;color:var(--accent)}
.reveal-body table{width:100%;border-collapse:collapse;font-size:0.72rem;font-family:var(--mono);margin:6px 0}
.reveal-body table td,.reveal-body table th{padding:3px 8px;border:1px solid var(--line);text-align:left}
.reveal-body table th{color:var(--faint);font-size:.65rem}

/* REFUSAL */
.refusal{margin-top:34px;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--void);border-radius:10px;padding:18px}
.refusal .rt{font-family:var(--mono);font-size:11px;color:var(--void);letter-spacing:1px;font-weight:700;margin-bottom:8px}
.refusal p{font-size:12px;color:var(--dim);line-height:1.65}
.foot{margin-top:24px;font-family:var(--mono);font-size:9px;color:var(--faint);text-align:center;line-height:2}

@media(max-width:760px){
  .lungs,.grid9,.subscores{grid-template-columns:1fr}
  .sliders{grid-template-columns:1fr}
  .pulseval{font-size:40px}
  .zen-pulse{font-size:.62rem;gap:1rem;padding:.4rem 1rem}
}
</style>
</head>
<body>

<div class="zen-pulse">
  <div class="zp-item"><span class="pulsedot" id="navdot"></span><span class="zp-ask">Where am I?</span><span class="zp-val">VITALS · PETRONAS φ</span></div>
  <div class="zp-item"><span class="zp-ask">Why care?</span><span class="zp-val">One body. Two lungs. Nine tripwires. Malaysia's shadow sovereign balance sheet, live.</span></div>
  <div class="zp-item"><span class="zp-ask">What next?</span><span class="zp-val">Examine the pulse ↓</span></div>
  <div class="navlinks">
    <a href="/oil/">OIL</a>
    <a href="/gas/">GAS</a>
    <a href="/gold/">GOLD</a>
    <a href="/vitals/" class="here">VITALS</a>
  </div>
</div>

<div class="wrap">

<!-- HERO -->
<div class="hero">
  <div class="tagline">Exteroception Organ · senses, never actuates · reports to SENSE111</div>
  <h1>One body. Two lungs. <span>Nine tripwires.</span><span class="pulse-tag">INTERPRET</span></h1>
  <div class="pulsebar-wrap">
    <div class="pulsehead">
      <div>
        <span class="pulseval mono" id="pulseval">–</span>
        <span class="verdictword" id="pulseverdict">–</span>
      </div>
      <div class="qoq">composite pulse · weighted blend of EVIDENCE + INTERPRET metrics<br><span style="color:var(--faint)">BODY 0.40 + SPINE 0.35 + SOUL 0.25 · computed, never asserted</span></div>
    </div>
    <div class="bar"><div class="barfill" id="pulsefill"></div></div>
    <div class="bands"><span>0 VOID</span><span>40 HOLD</span><span>60 SABAR</span><span>80 SEAL</span><span>100</span></div>
    <div class="lastseal">last re-sealed: <b id="sealdate">24 July 2026</b> <span class="stale-badge fresh" id="sealbadge">FRESH</span> · next audit due: 24 Oct 2026</div>
    <div class="subscores">
      <div class="sub"><div class="lab">🫀 BODY · solvency</div><div class="val mono" id="sb-body">–</div><div class="wt">0.40 · FCF·gearing·CFFO</div><div class="subtag" style="background:rgba(49,196,141,.12);color:var(--seal)">EVIDENCE</div></div>
      <div class="sub"><div class="lab">🦴 SPINE · franchise</div><div class="val mono" id="sb-spine">–</div><div class="wt">0.35 · production·recycling·payout</div><div class="subtag" style="background:rgba(227,179,65,.12);color:var(--sabar)">MIXED</div></div>
      <div class="sub"><div class="lab">🕊️ SOUL · DNA</div><div class="val mono" id="sb-soul">–</div><div class="wt">0.25 · enabler mix·governance·extraction</div><div class="subtag" style="background:rgba(227,179,65,.12);color:var(--sabar)">INTERPRET</div></div>
    </div>
  </div>
  <div class="verb-cta">
    <a href="#tripwires">Examine tripwires</a>
    <a href="#sensitivities">Sensitivity coefficients</a>
    <a href="#lungs">Inspect systems</a>
    <a href="#fan">Simulate trajectory</a>
    <a href="#basics">Modeling basics</a>
  </div>
</div>

<!-- MODELING BASICS — XOM-style methodology disclosure -->
<div class="sec" id="basics">
  <div class="sectitle">Modeling basics · how to read this organ</div>
  <details class="zen-reveal" open>
    <summary>Pulse computation methodology</summary>
    <div class="reveal-body">
      <h5>What the pulse measures</h5>
      <p>The composite PULSE (0–100) is a weighted blend of three sub-scores, each computed from three tripwires measuring their distance from a breaking threshold. It does not predict collapse. It measures the gap between current readings and the <code>safe</code>/<code>trip</code> anchors encoded in the data constitution.</p>
      <h5>How sub-scores are computed</h5>
      <p>Each tripwire <em>t</em> has three anchors: <code>now</code> (current reading), <code>trip</code> (breaking threshold), and <code>safe</code> (healthy anchor). The score is distance-to-trip normalized to 0–100:</p>
      <table><tr><th>Direction</th><th>Formula</th><th>Example</th></tr>
      <tr><td><code>dir: "below"</code> (going below = pain)</td><td><code>score = (now − trip) / (safe − trip) × 100</code></td><td>FCF: (7−0)/(15−0)×100 = 46.7</td></tr>
      <tr><td><code>dir: "above"</code> (going above = pain)</td><td><code>score = (trip − now) / (trip − safe) × 100</code></td><td>Gearing: (40−20.7)/(40−15)×100 = 77.2</td></tr></table>
      <p>The layer score is the mean of its three tripwire scores. The composite is: <code>PULSE = 0.40·BODY + 0.35·SPINE + 0.25·SOUL</code>.</p>
      <h5>Verdict bands</h5>
      <table><tr><th>Score</th><th>Verdict</th><th>Meaning</th></tr>
      <tr><td>80–100</td><td style="color:var(--seal)">SEAL</td><td>Body + soul intact</td></tr>
      <tr><td>60–79</td><td style="color:var(--sabar)">SABAR</td><td>Solvent, franchise fraying</td></tr>
      <tr><td>40–59</td><td style="color:var(--hold)">HOLD</td><td>Structural decay outrunning cash</td></tr>
      <tr><td>&lt;40</td><td style="color:var(--void)">VOID</td><td>Hollow shell, technically solvent</td></tr></table>
      <h5>How to re-seal (quarterly update)</h5>
      <p>Edit the 9 <code>now:</code> fields in the <code>TRIPWIRES[]</code> array. Everything else — scores, colors, verdicts, animations — derives from those 9 values. The <code>safe</code> and <code>trip</code> anchors are constitutional; changing them is a sovereign act. After updating <code>now:</code>, update the <code>sealed:</code> date on each tripwire and the global <code>last_sealed:</code> timestamp.</p>
      <h5>Epistemic honesty</h5>
      <p>BODY tripwires (#1–3) are <span class="tag EVIDENCE">EVIDENCE</span> — grounded in audited FY2025 IFR. SPINE and SOUL tripwires (#4–9) carry <span class="tag INTERPRET">INTERPRET</span> tags — they're inferences from judgment-anchors. The composite PULSE inherits the weaker tag: <b>INTERPRET, given chosen anchors</b>. The organ cannot be more objective than the <code>safe</code> values encoded in it. That exposure is the honesty.</p>
    </div>
  </details>
  <details class="zen-reveal">
    <summary>Theoretical spine · Acemoglu (analogy) + simulative institution + Calhoun (contested metaphor)</summary>
    <div class="reveal-body">
      <p><b>Acemoglu &amp; Robinson (analogy, not direct application):</b> Institutions hollow before they run out of money. Extraction can rise while the surface stays inclusive. This is a productive analogy — <em>not</em> the theory operating in its original domain (nation-state political economy). Tag: INTERPRET.</p>
      <p style="margin-top:8px"><b>Simulative institution (Arif's forensic frame):</b> Reform can be performed to absorb pressure without touching the extractive core. Tripwires #5 (Capital Recycling), #8 (Governance Separation), and #9 (Sovereign Extraction) are the structural detectors. Tag: INTERPRET.</p>
      <p style="margin-top:8px"><b>Calhoun's Universe 25 (contested metaphor, not predictive):</b> Abundance ≠ health; behaviors that built value can erode while resources remain. The science is contested (non-replication, enclosure confounds). Used as narrative frame only. Tag: INTERPRET-LOW.</p>
    </div>
  </details>
</div>

<!-- LUNGS -->
<div class="sec" id="lungs">
  <div class="sectitle">Three systems · tap to expand</div>
  <div class="lungs" id="lungs-el"></div>
</div>

<!-- 9 TRIPWIRES -->
<div class="sec" id="tripwires">
  <div class="sectitle">The 9 tripwires · distance-to-trip</div>
  <div class="grid9" id="grid9"></div>
</div>

<!-- SENSITIVITY COEFFICIENTS — XOM-style published deltas -->
<div class="sec" id="sensitivities">
  <div class="sectitle">Sensitivity coefficients · published model inputs</div>
  <div class="refpanel">
    <h4>Earnings sensitivity to key variables · FY2025 baseline</h4>
    <table class="senstable">
      <thead><tr><th>Variable</th><th>Δ Change</th><th>PAT Impact (RM B)</th><th>CFFO Impact (RM B)</th><th>FCF Impact (RM B)</th><th>Source</th></tr></thead>
      <tbody>
        <tr class="section-row"><td colspan="6">PRICE SENSITIVITIES</td></tr>
        <tr><td>Brent crude</td><td class="num">+$10 /bbl</td><td class="num impact" style="color:var(--seal)">+5.5 to +7.5</td><td class="num">+6.0</td><td class="num">+6.0</td><td>FY2025 IFR sensitivity disclosure</td></tr>
        <tr><td>JKM LNG spot</td><td class="num">+$1 /MMBtu</td><td class="num impact" style="color:var(--seal)">+1.2</td><td class="num">+1.2</td><td class="num">+1.2</td><td>MoF / contract mix estimate</td></tr>
        <tr><td>Singapore GRM</td><td class="num">+$1 /bbl</td><td class="num impact" style="color:var(--seal)">+0.15 to +0.30</td><td class="num">+0.25</td><td class="num">+0.25</td><td>FY2025 downstream disclosure</td></tr>
        <tr><td>Naphtha-PE spread</td><td class="num">+$100 /T</td><td class="num impact" style="color:var(--seal)">+0.30 to +0.50</td><td class="num">+0.40</td><td class="num">+0.40</td><td>PRefChem commissioning sensitivity</td></tr>
        <tr class="section-row"><td colspan="6">PRODUCTION SENSITIVITIES</td></tr>
        <tr><td>Crude production</td><td class="num">+10 kbpd</td><td class="num impact" style="color:var(--seal)">+0.8 to +1.2</td><td class="num">+1.0</td><td class="num">+1.0</td><td>DOSM / IFR production data</td></tr>
        <tr><td>LNG production</td><td class="num">+1 mtpa</td><td class="num impact" style="color:var(--seal)">+2.5 to +3.5</td><td class="num">+3.0</td><td class="num">+3.0</td><td>MLNG / Petronas LNG complex</td></tr>
        <tr class="section-row"><td colspan="6">FISCAL SENSITIVITIES</td></tr>
        <tr><td>Corporate tax rate</td><td class="num">+1 ppt</td><td class="num impact" style="color:var(--void)">−1.4 to −1.6</td><td class="num">−1.5</td><td class="num">−1.5</td><td>MoF / CITA 1967</td></tr>
        <tr><td>Govt dividend floor</td><td class="num">+RM5 B</td><td class="num impact" style="color:var(--void)">0 (PAT-neutral)</td><td class="num">−5.0</td><td class="num">−5.0</td><td>MoF Budget 2026; cash flow impact only</td></tr>
        <tr class="section-row"><td colspan="6">BALANCE SHEET SENSITIVITIES</td></tr>
        <tr><td>MYR/USD</td><td class="num">+0.10 RM/$</td><td class="num impact" style="color:var(--void)">−0.5 to +0.3</td><td class="num">mixed</td><td class="num">mixed</td><td>natural hedge; net exporter position</td></tr>
        <tr><td>Interest rate (base)</td><td class="num">+100 bps</td><td class="num impact" style="color:var(--void)">−0.25 to −0.40</td><td class="num">−0.35</td><td class="num">−0.35</td><td>RM82.8B net cash; low rate sensitivity</td></tr>
      </tbody>
    </table>
    <div style="font-family:var(--mono);font-size:9px;color:var(--faint);margin-top:10px">
      All coefficients are INTERPRET — derived from FY2025 IFR disclosures, cross-checked against Moody's A3 stable assumptions. Not audited by PETRONAS. Published as modeling inputs per ExxonMobil toolkit convention.
    </div>
  </div>
</div>

<!-- REFERENCE INPUTS -->
<div class="sec" id="refs">
  <div class="sectitle">Modeling inputs · FY2025 audited anchors</div>
  <div class="refpanel">
    <h4>Scenario assumptions</h4>
    <table class="reftable">
      <thead><tr><th>Parameter</th><th>Base</th><th>Bear</th><th>Bull</th><th>Source</th></tr></thead>
      <tbody>
        <tr><td>Brent crude (USD/bbl)</td><td class="num">85</td><td class="num">65</td><td class="num">105</td><td>Moody's / forward curve</td></tr>
        <tr><td>JKM LNG (USD/MMBtu)</td><td class="num">14</td><td class="num">10</td><td class="num">18</td><td>MoF / global LNG balance</td></tr>
        <tr><td>Crude production (kbpd)</td><td class="num">355</td><td class="num" style="color:var(--void)">300</td><td class="num">400</td><td>FY2025 IFR / DOSM</td></tr>
        <tr><td>Govt dividend floor (RM B)</td><td class="num">20.0</td><td class="num">20.0</td><td class="num">20.0</td><td>MoF Budget 2026</td></tr>
        <tr><td>Capex (RM B)</td><td class="num">47.5</td><td class="num">40.0</td><td class="num">55.0</td><td>FY2025 IFR</td></tr>
        <tr><td>PRefChem debt gross-up (RM B)</td><td class="num">35.0</td><td class="num">35.0</td><td class="num">35.0</td><td>FY2025 audited (one-time)</td></tr>
        <tr><td>PETROS gas transfer impact</td><td class="num">marginal</td><td class="num">moderate</td><td class="num">none</td><td>INTERPRET — ruling pending</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- FAN CHART -->
<div class="sec" id="fan">
  <div class="sectitle">Quantum path · net-cash trajectory 2025 → 2031</div>
  <div class="fanwrap">
    <div class="sliders">
      <div class="slider"><label>Brent (USD/bbl) <b id="brentv">85</b></label>
        <input type="range" min="55" max="125" value="85" id="brent"></div>
      <div class="slider"><label>JKM LNG (USD/MMBtu) <b id="jkmv">14</b></label>
        <input type="range" min="7" max="26" value="14" id="jkm"></div>
    </div>
    <div class="readout">
      <div class="ro"><div class="l">LIVE CFFO est.</div><div class="v mono" id="ro-cffo">–</div></div>
      <div class="ro"><div class="l">LIVE FCF est.</div><div class="v mono" id="ro-fcf">–</div></div>
      <div class="ro"><div class="l">net-debt crossover</div><div class="v mono" id="ro-cross">–</div></div>
    </div>
    <canvas id="fan" width="1040" height="380"></canvas>
    <div class="legend">
      <span><i class="dot" style="background:var(--seal)"></i>Bull</span>
      <span><i class="dot" style="background:var(--accent)"></i>Base</span>
      <span><i class="dot" style="background:var(--void)"></i>Bear</span>
      <span><i class="dot" style="background:var(--sabar)"></i>Live (slider)</span>
      <span><i class="dot" style="background:#f0506e;opacity:.5"></i>Net-debt tripwire (0)</span>
    </div>
  </div>
</div>

<!-- REFUSAL -->
<div class="refusal">
  <div class="rt">⛔ REFUSAL SURFACE</div>
  <p><b>This organ senses; it does not act.</b> No buy, sell, hold, or allocation signals. It reports institutional distance-to-break only. Actuation stays behind the A-FORGE governance gate. Every metric carries its epistemic tag (EVIDENCE / INTERPRET) on its face. The composite pulse is INTERPRET because SPINE and SOUL sub-scores are built on inference anchors. The organ cannot be more objective than the judgments encoded in its <code>safe</code> values. That exposure is the honesty.</p>
</div>

<div class="foot">
  All financial numbers: PETRONAS audited FY2025 IFR · MoF Budget 2026 · Moody's (A3 stable) · DOSM.<br>
  Projections are scenario bands (INTERPRET), not forecasts. Re-sealable: edit the TRIPWIRES array only.<br>
  PETRONAS·φ VITALS v1.2 · zen-pulse · config-driven · XOM-disciplined · F13 sovereign: ARIF<br>
  v1.2: +dated seals w/ auto-stale · +Modeling Basics · +sensitivity coefficient table · tense ≤25 · Calhoun=contested · Acemoglu=analogy
</div>

</div>

<script>
/* ============================================================
   LAYER 0 — DATA AS CONSTITUTION
   sealed: ISO date of last now-value update (XOM discipline)
   ============================================================ */
const SEAL_BASE="2026-07-24"; // global last-sealed date
const STALE_DAYS=90;

const TRIPWIRES=[
 {id:1,layer:"BODY",name:"FCF after capex & dividend",now:7.0,trip:0,safe:15,unit:"RM B",dir:"below",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"tax double-count removed; positive in FY25; bear case trips ~2027–28"},
 {id:2,layer:"BODY",name:"Gearing ratio",now:20.7,trip:40,safe:15,unit:"%",dir:"above",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"audited 20.7%; steps to ~25–27% on PRefChem consolidation (one-time)"},
 {id:3,layer:"BODY",name:"CFFO — master variable",now:85.2,trip:60,safe:95,unit:"RM B",dir:"below",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"the root. Below RM60B forces trade-off between dividend, capex, and balance sheet"},

 {id:4,layer:"SPINE",name:"Production / reserve replacement",now:355,trip:300,safe:500,unit:"kbpd",dir:"below",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"crude ~355kbpd, secular decline from 1995 peak (~638k). Physics floor under every financial number"},
 {id:5,layer:"SPINE",name:"Capital Recycling Ratio",now:1.2,trip:1.0,safe:2.0,unit:"×",dir:"below",tag:"INTERPRET",sealed:"2026-07-24",
  note:"domestic reinvestment ÷ asset sale proceeds. Below 1.0× = eating seed corn vs high-grading"},
 {id:6,layer:"SPINE",name:"Dividend-to-FCF payout",now:84,trip:100,safe:50,unit:"%",dir:"above",tag:"EVIDENCE",sealed:"2026-07-24",
  note:"THE HINGE. FY25 covered (84%). Rises as CFFO falls — above 100% = debt-funded dividend"},

 {id:7,layer:"SOUL",name:"Enabler ratio (rightsizing gauge)",now:30,trip:35,safe:20,unit:"%",dir:"above",tag:"INTERPRET",sealed:"2026-07-24",
  note:"~15.5k enablers of ~52k staff; cutting ~5,000 (concludes Aug 2026). Healthy if admin; wounding if technical core"},
 {id:8,layer:"SOUL",name:"Governance separation index",now:1,trip:0,safe:3,unit:"idx",dir:"below",tag:"INTERPRET",sealed:"2026-07-24",
  note:"dual chair (PETRONAS + Gentari) + CFO overlap = concentrated governance perimeter"},
 {id:9,layer:"SOUL",name:"Sovereign extraction gauge",now:50,trip:60,safe:30,unit:"% of PAT",dir:"above",tag:"INTERPRET",sealed:"2026-07-24",
  note:"~RM42B (div + tax) ≈ 50% of PAT. Narrative pivot ('only 12.5% of revenue') is the structural tell"}
];

const WEIGHTS={BODY:0.40,SPINE:0.35,SOUL:0.25};

/* ---- LAYER 1: pure computation ---- */
function score(t){
  const now=Math.round(t.now*10)/10, trip=Math.round(t.trip*10)/10, safe=Math.round(t.safe*10)/10;
  let s;
  if(t.dir==="below") s=(now-trip)/(safe-trip)*100;
  else                s=(trip-now)/(trip-safe)*100;
  return Math.max(0,Math.min(100,Math.round(s*10)/10));
}
function verdict(v){
  if(v>=80)return{w:"SEAL",c:"var(--seal)"};
  if(v>=60)return{w:"SABAR",c:"var(--sabar)"};
  if(v>=40)return{w:"HOLD",c:"var(--hold)"};
  return{w:"VOID",c:"var(--void)"};
}
function layerScore(L){
  const m=TRIPWIRES.filter(t=>t.layer===L);
  return Math.round(m.reduce((a,t)=>a+score(t),0)/m.length*10)/10;
}
const S={BODY:layerScore("BODY"),SPINE:layerScore("SPINE"),SOUL:layerScore("SOUL")};
const PULSE=Math.round((WEIGHTS.BODY*S.BODY+WEIGHTS.SPINE*S.SPINE+WEIGHTS.SOUL*S.SOUL)*10)/10;

/* ---- stale detection ---- */
function daysSince(d){return Math.floor((Date.now()-new Date(d).getTime())/86400000);}
const sealAge=daysSince(SEAL_BASE);
document.getElementById("sealbadge").textContent=sealAge<=STALE_DAYS?"FRESH":"STALE";
document.getElementById("sealbadge").className="stale-badge "+(sealAge<=STALE_DAYS?"fresh":"stale");
document.getElementById("sealdate").textContent=SEAL_BASE;

/* ---- render hero ---- */
const pv=verdict(PULSE);
pulseval.textContent=PULSE.toFixed(0);
pulseverdict.textContent=pv.w;
pulseverdict.style.background=pv.c+"22";pulseverdict.style.color=pv.c;
pulsefill.style.width=PULSE+"%";pulsefill.style.background=pv.c;
navdot.style.background=pv.c;
function setSub(id,val,tag){const v=verdict(val);const e=document.getElementById(id);e.textContent=val.toFixed(0);e.style.color=v.c;}
setSub("sb-body",S.BODY);setSub("sb-spine",S.SPINE);setSub("sb-soul",S.SOUL);

/* ---- render lungs ---- */
const lungMeta={
  BODY:{icon:"🫀",sub:"can it pay its bills · EVIDENCE-grounded"},
  SPINE:{icon:"🦴",sub:"is the franchise intact · mixed"},
  SOUL:{icon:"🕊️",sub:"is the DNA being hollowed · INTERPRET-grounded"}
};
const lungsEl=document.getElementById("lungs-el");
["BODY","SPINE","SOUL"].forEach(L=>{
  const ls=S[L],lv=verdict(ls);
  const rows=TRIPWIRES.filter(t=>t.layer===L).map(t=>{
    const sc=score(t),v=verdict(sc),sd=daysSince(t.sealed);
    const staleHtml=sd>STALE_DAYS?`<span class="stale-badge stale">STALE ${sd}d</span>`:`<span class="stale-badge fresh">sealed ${t.sealed}</span>`;
    return `<div class="metricrow">
      <div class="metrictop"><span class="metricname">${t.id}. ${t.name}</span><span class="tag ${t.tag}">${t.tag}</span></div>
      <div class="metricnums">now <b>${t.now}${t.unit}</b> · trip ${t.dir==="below"?"&lt;":">"}${t.trip}${t.unit} · safe ${t.safe}${t.unit}</div>
      <div class="dtt"><div class="dttfill" style="width:${sc}%;background:${v.c}"></div></div>
      <div class="dttlabel"><span style="color:${v.c}">${v.w} · ${sc.toFixed(0)}/100</span><span>${t.note}</span></div>
      <div class="metricseal">${staleHtml}</div>
    </div>`;
  }).join("");
  const el=document.createElement("div");
  el.className="lung";
  el.innerHTML=`<div class="lunghead">
      <div class="lungname">${lungMeta[L].icon} ${L}<small>${lungMeta[L].sub}</small></div>
      <div class="lunglight" style="background:${lv.c}22;color:${lv.c}">${ls.toFixed(0)}</div>
    </div><div class="lungbody">${rows}</div>`;
  el.querySelector(".lunghead").onclick=()=>el.classList.toggle("open");
  lungsEl.appendChild(el);
});

/* ---- render 9 tripwire grid ---- */
const g=document.getElementById("grid9");
TRIPWIRES.forEach(t=>{
  const sc=score(t),v=verdict(sc),sd=daysSince(t.sealed);
  const tense=sc<=25?"tense":"";
  const staleCls=sd>STALE_DAYS?" stale-cell":"";
  const c=document.createElement("div");
  c.className="cell "+tense+staleCls;
  const staleTag=sd>STALE_DAYS?`<span style="color:var(--hold);font-size:8px"> ⚠ STALE ${sd}d</span>`:"";
  c.innerHTML=`<div class="idx mono">#${t.id}</div>
    <div class="cn">${t.name}</div><div class="cl">${t.layer} · ${t.tag}${staleTag}</div>
    <div class="gauge"><div class="gaugefill" style="width:${sc}%;background:${v.c}"></div><div class="gaugetrip" style="left:2%"></div></div>
    <div class="cellnums"><span>${t.now}${t.unit}</span><span>trip ${t.dir==="below"?"&lt;":">"}${t.trip}${t.unit}</span></div>
    <div class="cellverdict" style="color:${v.c}">${v.w} · ${sc<=25?"⚠ near trip":sc.toFixed(0)+"/100"}</div>
    <div class="cellseal">sealed ${t.sealed}</div>`;
  g.appendChild(c);
});

/* ============================================================
   LAYER 3 — QUANTUM PATH (fan chart)
   ============================================================ */
const YEARS=[2025,2026,2027,2028,2029,2030,2031];
const START=82.8, PREF_DEBT=35;
const cumBase=[0,19,26,27,24.5,18,9];
const cumBear=[0,11.5,5.5,-8.5,-28,-51.5,-78.5];
const cumBull=[0,25.5,44,57,66.5,72.5,74.5];
function netCash(cum){return cum.map((c,i)=> i===0?START : Math.round((START-PREF_DEBT+c)*10)/10 );}
const nBase=netCash(cumBase),nBear=netCash(cumBear),nBull=netCash(cumBull);
function firstCross(arr){for(let i=1;i<arr.length;i++){if(arr[i]<0)return YEARS[i];}return null;}

const cv=document.getElementById("fan"),ctx=cv.getContext("2d");
function draw(live){
  const W=cv.width,H=cv.height,pad=44;
  ctx.clearRect(0,0,W,H);
  const all=[...nBase,...nBear,...nBull,...(live||[])];
  const max=Math.max(...all,90),min=Math.min(...all,-90);
  const x=i=>pad+(W-pad*1.4)*i/(YEARS.length-1);
  const y=v=>pad/2+(H-pad*1.5)*(max-v)/(max-min);
  ctx.strokeStyle="#1f2733";ctx.lineWidth=1;ctx.fillStyle="#5a6675";ctx.font="11px monospace";
  YEARS.forEach((yr,i)=>{ctx.beginPath();ctx.moveTo(x(i),pad/2);ctx.lineTo(x(i),H-pad);ctx.stroke();ctx.fillText(yr,x(i)-14,H-pad+16);});
  ctx.strokeStyle="rgba(240,80,110,.5)";ctx.setLineDash([6,4]);ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(pad,y(0));ctx.lineTo(W-pad*0.4,y(0));ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle="#f0506e";ctx.fillText("NET-DEBT TRIPWIRE (0)",pad+4,y(0)-6);
  ctx.fillStyle="#5a6675";[max,0,min].forEach(v=>{ctx.fillText(Math.round(v)+"B",4,y(v)+4);});
  function line(arr,color,w){ctx.strokeStyle=color;ctx.lineWidth=w;ctx.beginPath();arr.forEach((v,i)=>{i?ctx.lineTo(x(i),y(v)):ctx.moveTo(x(i),y(v));});ctx.stroke();
    arr.forEach((v,i)=>{ctx.fillStyle=color;ctx.beginPath();ctx.arc(x(i),y(v),2.5,0,7);ctx.fill();});}
  line(nBull,"#31c48d",2);
  line(nBase,"#4aa8ff",2.5);
  line(nBear,"#f0506e",2);
  if(live)line(live,"#e3b341",2.5);
}

const brent=document.getElementById("brent"),jkm=document.getElementById("jkm");
function live(){
  const B=+brent.value,J=+jkm.value;
  brentv.textContent=B;jkmv.textContent=J;
  const cffo=Math.round((82+(B-85)*0.6+(J-14)*1.2)*10)/10;
  const fcf=Math.round((cffo-47.5-24.5-2.5)*10)/10;
  ro_cffo.textContent="RM"+cffo.toFixed(1)+"B";
  ro_fcf.textContent=(fcf>=0?"+":"")+"RM"+fcf.toFixed(1)+"B";
  ro_fcf.style.color=fcf>=0?"var(--seal)":"var(--void)";
  const lv=[START];let n=Math.round((START-PREF_DEBT)*10)/10;
  for(let i=1;i<YEARS.length;i++){n=Math.round((n+fcf)*10)/10;lv.push(n);}
  const cross=firstCross(lv);
  ro_cross.textContent=cross?cross:"none &lt;2031";
  ro_cross.style.color=cross?"var(--void)":"var(--seal)";
  draw(lv);
}
brent.oninput=live;jkm.oninput=live;
live();
</script>
</body>
</html>