# Cloudflare Pages redirect rules
# Place in public/_redirects — copied to dist/ on build
# Ensures /data/* is served as static files, NOT routed to SPA index.html

# Serve data directory as static files (200 status = don't redirect, just serve)
/data/*   /data/:splat   200

# Fix clean URLs for subdirectory index.html pages (SPA mode fallback fix)
/canon         /canon/index.html         200
/999           /999/index.html           200
/000           /000/index.html           200
/charter       /charter/index.html       200
/governance    /governance/index.html    200
/audit         /audit/index.html         200
/constitution  /constitution/index.html  200

# 2026-08-03: AAA + Vitals + cockpit + GEOX sub-pages (49 gaps closed)
/aaa           /aaa/index.html           200
/aaa/*         /aaa/:splat               200
/vitals        /vitals/index.html        200
/vitals/*      /vitals/:splat            200
/cockpit       /aaa/cockpit/index.html   200
/geox          /geox/index.html          200
/geox/*        /geox/:splat              200

# /institution is SPA route — handled by React Router via fallback
# (no static rewrite needed; Cloudflare Pages fallback to /index.html)
