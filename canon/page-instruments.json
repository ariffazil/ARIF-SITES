      "fallback": "static-canon",
      "interactive": "scroll-parallax",
      "render_mode": "agent_canvas_optional",
      "where": ["earth-only", "root", "sovereign"]
    },
    "basin-cross-section": {
      "description": "A horizontal cross-section of a basin. Plate-edged, geological, depth-true.",
